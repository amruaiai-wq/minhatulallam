---
import Base from "../layouts/Base.astro";
import { babs, KNAME, label, topicUrl, url, entryForTopic } from "../lib/data";
import { ICON } from "../lib/icons";
const vols = [...new Set(babs.map((b) => b.volume))];
let lastHead = "";
const rows = babs.map((b) => {
  const head = `เล่ม ${b.volume} · ${KNAME[b.kitab]}`;
  const showHead = head !== lastHead; lastHead = head;
  const items = b.topics.map((t) => ({ t, e: entryForTopic(b, t) }));
  return { b, head, showHead, items, n: items.filter((x) => x.e).length };
});
---
<Base title="สารบัญ" tab="toc">
  <div class="view">
    <div class="topbar">
      <a class="icon-btn" href={url()} aria-label="กลับหน้าแรก" set:html={ICON.back} />
      <div class="t"><small>เล่ม {vols.length > 1 ? `${vols[0]}–${vols[vols.length - 1]}` : vols[0]}</small><b>สารบัญ</b></div>
    </div>
    <div class="pad" style="padding-block:16px;display:flex;flex-direction:column;gap:12px">
      {rows.map(({ b, head, showHead, items, n }) => (
        <>
          {showHead && <h2 class="h2" style="margin-top:8px">{head}</h2>}
          <section class="card bab" id={`bab-${b.volume}-${b.id}`}>
            <div class="bab-head">
              <div><div style="font-weight:700">{b.th}</div><div class="muted" style="font-size:12px">สรุปแล้ว {n} จาก {b.topics.length} หัวข้อ</div></div>
              <div class="ar" lang="ar">{b.ar}</div>
            </div>
            {b.intro_th && <a class="intro-link" href={url(`intros/#intro-${b.volume}-${b.id}`)}>อ่านบทนำของบาบ ›</a>}
            {items.map(({ t, e }) => e
              ? <a class="topic-link" href={topicUrl(e)}><span>{e.topic_th}</span><b>หะดีษที่ {label(e)}</b></a>
              : <span class="topic-link off"><span class="ar" lang="ar" style="text-align:left;direction:rtl">{t.ar}</span><b>รอสรุป</b></span>)}
          </section>
        </>
      ))}
    </div>
  </div>
</Base>
